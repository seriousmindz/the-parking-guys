                    if (item.label === 'Solutions') setShowSolutions(true)
                    if (item.label === 'Blog') setShowBlog(true)
                    if (item.label === 'RFP & Procurement') setShowRFP(true)
                    if (item.label === 'About') setShowAbout(true)
