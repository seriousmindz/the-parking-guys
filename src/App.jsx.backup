                    <Card key={study.id} className="cursor-pointer hover:shadow-lg transition-shadow">
                      <CardContent className="p-6" onClick={() => setSelectedCaseStudy(study)}>
                        <div className="mb-4">
                          <Badge className="mb-2 bg-blue-100 text-blue-800">{study.industry}</Badge>
