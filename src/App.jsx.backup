        </div>
      </footer>

        {/* Blog Modal */}
        {showBlog && (
          <div className="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
            <div className="bg-white rounded-lg max-w-4xl w-full max-h-[90vh] overflow-hidden shadow-2xl">
              <div className="flex justify-between items-center p-6 border-b bg-white">
                <h2 className="text-2xl font-bold text-gray-900">Parking Industry Insights & Trends</h2>
                <button 
                  onClick={() => setShowBlog(false)}
                  className="text-gray-500 hover:text-gray-700 p-2"
                >
                  ✕
                </button>
              </div>
              
              <div className="overflow-y-auto max-h-[calc(90vh-80px)] bg-white">
                <div className="p-6">
                  <p className="text-lg text-gray-600 mb-6">
                    Expert perspectives on the future of parking, technology innovations, and industry best practices from leading professionals.
                  </p>
                  
                  <div className="mb-8">
                    <h3 className="text-lg font-semibold mb-4 text-gray-900">Categories</h3>
                    <div className="flex flex-wrap gap-3">
                      <span className="px-3 py-1 rounded-full text-sm font-medium text-white bg-blue-600">
                        Technology (5)
                      </span>
                      <span className="px-3 py-1 rounded-full text-sm font-medium text-white bg-green-600">
                        Industry Trends (3)
                      </span>
                    </div>
                  </div>
                  
                  <div className="mb-8 p-6 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg border border-blue-200">
                    <div className="flex items-start justify-between mb-4">
                      <span className="px-3 py-1 bg-blue-600 text-white text-sm font-medium rounded-full">Featured</span>
                      <span className="text-sm text-gray-500">September 28, 2025</span>
                    </div>
                    <h3 className="text-xl font-bold mb-2 text-gray-900">The Future of Parking: 2025 and Beyond</h3>
                    <p className="text-gray-600 mb-4">Exploring how AI, autonomous vehicles, and smart city initiatives are reshaping the parking landscape.</p>
                    <div className="flex items-center justify-between">
                      <div>
                        <p className="font-medium text-gray-900">Michael Rodriguez</p>
                        <p className="text-sm text-gray-500">Chief Technology Officer, The Parking Guys</p>
                      </div>
                      <span className="text-sm text-gray-500">8 min read</span>
                    </div>
                  </div>
                  
                  <div className="grid md:grid-cols-2 gap-6 mb-8">
                    <div 
                      className="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow cursor-pointer"
                      onClick={() => setSelectedBlogPost({
                        id: 'ai-revolution',
                        title: 'The AI Revolution in Parking Management',
                        content: 'Artificial intelligence is revolutionizing the parking industry. From predictive analytics to automated customer service, AI is making parking smarter and more efficient.\n\n## Predictive Analytics\n\nOur AI systems analyze historical data, weather patterns, and local events to predict parking demand with unprecedented accuracy. This allows parking operators to optimize pricing and staffing in real-time.\n\n## Dynamic Pricing\n\nAI-driven dynamic pricing adjusts rates based on demand, maximizing revenue while ensuring availability for customers. Our algorithms consider factors like time of day, local events, and historical patterns.\n\n## Customer Service Automation\n\nAI-powered chatbots and virtual assistants provide 24/7 customer support, handling common inquiries and resolving issues without human intervention.\n\n## Future Developments\n\nAs AI technology continues to evolve, we expect to see even more sophisticated applications in parking management, including computer vision for space detection and predictive maintenance for parking equipment.',
                        author: 'Dr. Sarah Chen',
                        author_title: 'AI Research Director',
                        date: 'September 25, 2025',
                        read_time: '6 min read',
                        category: 'Technology',
                        tags: ['AI', 'Machine Learning', 'Predictive Analytics']
                      })}
                    >
                      <div className="p-6">
                        <div className="flex items-center justify-between mb-3">
                          <span className="px-2 py-1 text-xs font-medium rounded-full text-white bg-blue-600">Technology</span>
                          <span className="text-sm text-gray-500">September 25, 2025</span>
                        </div>
                        <h3 className="text-lg font-semibold mb-2 text-gray-900">The AI Revolution in Parking Management</h3>
                        <p className="text-gray-600 text-sm mb-4">How artificial intelligence is transforming parking operations with 95% accuracy in demand forecasting.</p>
                        <div className="flex items-center justify-between">
                          <div>
                            <p className="font-medium text-sm text-gray-900">Dr. Sarah Chen</p>
                            <p className="text-xs text-gray-500">AI Research Director</p>
                          </div>
                          <span className="text-xs text-gray-500">6 min read</span>
                        </div>
                        <div className="mt-3 flex flex-wrap gap-1">
                          <span className="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">AI</span>
                          <span className="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">Machine Learning</span>
                        </div>
                      </div>
                    </div>
                    
                    <div 
                      className="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow cursor-pointer"
                      onClick={() => setSelectedBlogPost({
                        id: 'mobile-payments',
                        title: 'Mobile Payment Evolution in Parking',
                        content: 'The parking industry has undergone a dramatic transformation with the adoption of mobile payment technologies. Today, 75% of parking transactions are mobile-first, fundamentally changing how customers interact with parking services.\n\n## The Mobile Revolution\n\nMobile payments have eliminated the need for cash, coins, and even physical tickets. Customers can now pay for parking directly from their smartphones, creating a seamless and contactless experience.\n\n## Key Benefits\n\n### For Customers:\n- Contactless payments for safety and convenience\n- Real-time parking availability\n- Digital receipts and expense tracking\n- Ability to extend parking sessions remotely\n\n### For Operators:\n- Reduced cash handling and security risks\n- Real-time revenue tracking\n- Lower operational costs\n- Enhanced customer data and analytics\n\n## Future Trends\n\nWe expect to see continued innovation in mobile payments, including integration with smart city platforms, loyalty programs, and predictive parking recommendations.',
                        author: 'Jennifer Walsh',
                        author_title: 'Fintech Innovation Lead',
                        date: 'September 22, 2025',
                        read_time: '5 min read',
                        category: 'Technology',
                        tags: ['Mobile Payments', 'Customer Experience', 'Fintech']
                      })}
                    >
                      <div className="p-6">
                        <div className="flex items-center justify-between mb-3">
                          <span className="px-2 py-1 text-xs font-medium rounded-full text-white bg-blue-600">Technology</span>
                          <span className="text-sm text-gray-500">September 22, 2025</span>
                        </div>
                        <h3 className="text-lg font-semibold mb-2 text-gray-900">Mobile Payment Evolution in Parking</h3>
                        <p className="text-gray-600 text-sm mb-4">75% of parking transactions are now mobile-first, transforming the customer experience.</p>
                        <div className="flex items-center justify-between">
                          <div>
                            <p className="font-medium text-sm text-gray-900">Jennifer Walsh</p>
                            <p className="text-xs text-gray-500">Fintech Innovation Lead</p>
                          </div>
                          <span className="text-xs text-gray-500">5 min read</span>
                        </div>
                        <div className="mt-3 flex flex-wrap gap-1">
                          <span className="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">Mobile Payments</span>
                          <span className="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">Customer Experience</span>
                        </div>
                      </div>
                    </div>
                    
                    <div className="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
                      <div className="p-6">
                        <div className="flex items-center justify-between mb-3">
                          <span className="px-2 py-1 text-xs font-medium rounded-full text-white bg-green-600">Industry Trends</span>
                          <span className="text-sm text-gray-500">September 20, 2025</span>
                        </div>
                        <h3 className="text-lg font-semibold mb-2 text-gray-900">Autonomous Vehicles and Parking Infrastructure</h3>
                        <p className="text-gray-600 text-sm mb-4">How self-driving cars will reshape parking demand and urban planning strategies.</p>
                        <div className="flex items-center justify-between">
                          <div>
                            <p className="font-medium text-sm text-gray-900">Dr. Robert Kim</p>
                            <p className="text-xs text-gray-500">MIT Transportation Lab</p>
                          </div>
                          <span className="text-xs text-gray-500">7 min read</span>
                        </div>
                        <div className="mt-3 flex flex-wrap gap-1">
                          <span className="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">Autonomous Vehicles</span>
                          <span className="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">Future Planning</span>
                        </div>
                      </div>
                    </div>
                    
                    <div className="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
                      <div className="p-6">
                        <div className="flex items-center justify-between mb-3">
                          <span className="px-2 py-1 text-xs font-medium rounded-full text-white bg-green-600">Industry Trends</span>
                          <span className="text-sm text-gray-500">September 18, 2025</span>
                        </div>
                        <h3 className="text-lg font-semibold mb-2 text-gray-900">Sustainable Parking Solutions</h3>
                        <p className="text-gray-600 text-sm mb-4">Green parking initiatives reducing carbon footprint by 30-50% while improving efficiency.</p>
                        <div className="flex items-center justify-between">
                          <div>
                            <p className="font-medium text-sm text-gray-900">James Thompson</p>
                            <p className="text-xs text-gray-500">Sustainability Director</p>
                          </div>
                          <span className="text-xs text-gray-500">6 min read</span>
                        </div>
                        <div className="mt-3 flex flex-wrap gap-1">
                          <span className="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">Sustainability</span>
                          <span className="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">Green Solutions</span>
                        </div>
                      </div>
                    </div>
                  </div>
                  
                  <div className="text-center">
                    <button 
                      onClick={() => {
                        setShowBlog(false);
                        document.getElementById('contact-form')?.scrollIntoView({ behavior: 'smooth' });
                      }}
                      className="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors"
                    >
                      Contact Our Parking Experts
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Individual Blog Post Modal with Comments */}
        {selectedBlogPost && (
          <div className="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
            <div className="bg-white rounded-lg max-w-4xl w-full max-h-[90vh] overflow-hidden shadow-2xl">
              <div className="flex justify-between items-center p-6 border-b bg-white">
                <div className="flex items-center gap-4">
                  <button 
                    onClick={() => setSelectedBlogPost(null)}
                    className="text-gray-500 hover:text-gray-700 p-2"
                  >
                    ← Back to Blog
                  </button>
                  <span className={`px-3 py-1 rounded-full text-sm font-medium text-white ${
                    selectedBlogPost.category === 'Technology' ? 'bg-blue-600' : 'bg-green-600'
                  }`}>
                    {selectedBlogPost.category}
                  </span>
                </div>
                <button 
                  onClick={() => {
                    setSelectedBlogPost(null)
                    setShowBlog(false)
                  }}
                  className="text-gray-500 hover:text-gray-700 p-2"
                >
                  ✕
                </button>
              </div>
              
              <div className="overflow-y-auto max-h-[calc(90vh-80px)] bg-white">
                <div className="p-6">
                  {/* Article Header */}
                  <div className="mb-6">
                    <h1 className="text-3xl font-bold text-gray-900 mb-4">{selectedBlogPost.title}</h1>
                    <div className="flex items-center justify-between mb-4">
                      <div className="flex items-center gap-4">
                        <div>
                          <p className="font-medium text-gray-900">{selectedBlogPost.author}</p>
                          <p className="text-sm text-gray-500">{selectedBlogPost.author_title}</p>
                        </div>
                      </div>
                      <div className="text-right">
                        <p className="text-sm text-gray-500">{selectedBlogPost.date}</p>
                        <p className="text-sm text-gray-500">{selectedBlogPost.read_time}</p>
                      </div>
                    </div>
                    <div className="flex flex-wrap gap-2">
                      {selectedBlogPost.tags?.map((tag, index) => (
                        <span key={index} className="px-2 py-1 bg-gray-100 text-gray-600 text-sm rounded">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>

                  {/* Article Content */}
                  <div className="prose max-w-none mb-8">
                    {selectedBlogPost.content.split('\n\n').map((paragraph, index) => {
                      if (paragraph.startsWith('## ')) {
                        return <h2 key={index} className="text-2xl font-bold text-gray-900 mt-8 mb-4">{paragraph.replace('## ', '')}</h2>
                      } else if (paragraph.startsWith('### ')) {
                        return <h3 key={index} className="text-xl font-semibold text-gray-900 mt-6 mb-3">{paragraph.replace('### ', '')}</h3>
                      } else if (paragraph.startsWith('- ')) {
                        const listItems = paragraph.split('\n').filter(item => item.startsWith('- '))
                        return (
                          <ul key={index} className="list-disc pl-6 mb-4">
                            {listItems.map((item, itemIndex) => (
                              <li key={itemIndex} className="text-gray-700 mb-1">{item.replace('- ', '')}</li>
                            ))}
                          </ul>
                        )
                      } else {
                        return <p key={index} className="text-gray-700 mb-4 leading-relaxed">{paragraph}</p>
                      }
                    })}
                  </div>

                  {/* Comments Section */}
                  <div className="border-t pt-8">
                    <h3 className="text-2xl font-bold text-gray-900 mb-6">
                      Comments ({(comments[selectedBlogPost.id] || []).length})
                    </h3>

                    {/* Add Comment Form */}
                    <div className="mb-8 p-6 bg-gray-50 rounded-lg">
                      <h4 className="text-lg font-semibold text-gray-900 mb-4">Join the Discussion</h4>
                      <div className="space-y-4">
                        <input
                          type="text"
                          placeholder="Your name"
                          value={commentAuthor}
                          onChange={(e) => setCommentAuthor(e.target.value)}
                          className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        />
                        <textarea
                          placeholder="Share your thoughts..."
                          value={newComment}
                          onChange={(e) => setNewComment(e.target.value)}
                          rows={4}
                          className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        />
                        <button
                          onClick={() => addComment(selectedBlogPost.id)}
                          className="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors"
                        >
                          Post Comment
                        </button>
                      </div>
                    </div>

                    {/* Comments List */}
                    <div className="space-y-6">
                      {(comments[selectedBlogPost.id] || []).map((comment) => (
                        <div key={comment.id} className="border-l-4 border-blue-200 pl-6">
                          <div className="bg-white p-4 rounded-lg shadow-sm border border-gray-200">
                            <div className="flex items-center justify-between mb-3">
                              <div>
                                <h5 className="font-semibold text-gray-900">{comment.author}</h5>
                                {comment.company && (
                                  <p className="text-sm text-gray-500">{comment.company}</p>
                                )}
                              </div>
                              <span className="text-sm text-gray-500">{comment.date}</span>
                            </div>
                            <p className="text-gray-700 leading-relaxed">{comment.comment}</p>
                            
                            {/* Replies */}
                            {comment.replies && comment.replies.length > 0 && (
                              <div className="mt-4 ml-6 space-y-3">
                                {comment.replies.map((reply) => (
                                  <div key={reply.id} className="bg-gray-50 p-3 rounded-lg">
                                    <div className="flex items-center justify-between mb-2">
                                      <div>
                                        <h6 className="font-medium text-gray-900">{reply.author}</h6>
                                        {reply.company && (
                                          <p className="text-xs text-gray-500">{reply.company}</p>
                                        )}
                                      </div>
                                      <span className="text-xs text-gray-500">{reply.date}</span>
                                    </div>
                                    <p className="text-gray-700 text-sm">{reply.comment}</p>
                                  </div>
                                ))}
                              </div>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>

                    {/* Contact CTA */}
                    <div className="mt-8 text-center p-6 bg-blue-50 rounded-lg">
                      <h4 className="text-lg font-semibold text-gray-900 mb-2">Want to Learn More?</h4>
                      <p className="text-gray-600 mb-4">Connect with our parking experts to discuss your specific needs.</p>
                      <button 
                        onClick={() => {
                          setSelectedBlogPost(null)
                          setShowBlog(false)
                          document.getElementById('contact-form')?.scrollIntoView({ behavior: 'smooth' })
                        }}
                        className="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors"
                      >
                        Contact Our Experts
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* RFP & Procurement Modal */}
        {showRFP && (
          <div className="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
            <div className="bg-white rounded-lg max-w-7xl w-full max-h-[90vh] overflow-y-auto shadow-2xl">
              <div className="flex justify-between items-center p-6 border-b bg-white sticky top-0 z-10">
                <h2 className="text-3xl font-bold text-gray-900">{rfpData.rfp.title}</h2>
                <button 
                  onClick={() => {
                    setShowRFP(false)
                    setSelectedRFPIndustry(null)
                  }}
                  className="text-gray-500 hover:text-gray-700 p-2"
                >
                  ✕
                </button>
              </div>
              
              {!selectedRFPIndustry ? (
                <div className="p-6">
                  {/* Overview Section */}
                  <div className="mb-8 text-center">
                    <p className="text-lg text-gray-600 mb-6">{rfpData.rfp.description}</p>
                    <div className="bg-blue-50 rounded-lg p-6">
                      <h3 className="text-2xl font-bold text-gray-900 mb-4">{rfpData.rfp.overview.title}</h3>
                      <p className="text-gray-600 mb-6">{rfpData.rfp.overview.subtitle}</p>
                      <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                        {rfpData.rfp.overview.benefits.map((benefit, index) => (
                          <div key={index} className="flex items-center gap-3">
                            <CheckCircle className="h-5 w-5 text-green-500 flex-shrink-0" />
                            <span className="text-gray-700">{benefit}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>

                  {/* Industry-Specific RFP Templates */}
                  <div className="mb-8">
                    <h3 className="text-2xl font-bold text-gray-900 mb-6 text-center">Industry-Specific RFP Templates</h3>
                    <div className="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                      {rfpData.rfp.industries.map((industry) => (
                        <div 
                          key={industry.id}
                          className="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-lg transition-shadow cursor-pointer"
                          onClick={() => setSelectedRFPIndustry(industry)}
                        >
                          <div className="text-4xl mb-4 text-center">{industry.icon}</div>
                          <h4 className="text-lg font-semibold text-gray-900 mb-3 text-center">{industry.name}</h4>
                          <p className="text-gray-600 text-sm text-center">{industry.description}</p>
                          <div className="mt-4 text-center">
                            <span className="text-blue-600 text-sm font-medium">View RFP Template →</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>

                  {/* Procurement Process */}
                  <div className="mb-8">
                    <h3 className="text-2xl font-bold text-gray-900 mb-6 text-center">{rfpData.rfp.procurement_process.title}</h3>
                    <div className="grid md:grid-cols-5 gap-6">
                      {rfpData.rfp.procurement_process.steps.map((step, index) => (
                        <div key={index} className="text-center">
                          <div className="bg-blue-600 text-white rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-4 text-xl font-bold">
                            {step.step}
                          </div>
                          <h4 className="text-lg font-semibold text-gray-900 mb-2">{step.title}</h4>
                          <p className="text-gray-600 text-sm mb-2">{step.description}</p>
                          <p className="text-blue-600 text-sm font-medium">{step.duration}</p>
                        </div>
                      ))}
                    </div>
                  </div>

                  {/* Additional Resources */}
                  <div className="mb-8">
                    <h3 className="text-2xl font-bold text-gray-900 mb-6 text-center">{rfpData.rfp.resources.title}</h3>
                    <div className="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                      {rfpData.rfp.resources.documents.map((doc, index) => (
                        <div key={index} className="bg-gray-50 rounded-lg p-6">
                          <h4 className="text-lg font-semibold text-gray-900 mb-2">{doc.title}</h4>
                          <p className="text-gray-600 text-sm mb-3">{doc.description}</p>
                          <div className="flex items-center justify-between">
                            <span className="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs font-medium">{doc.type}</span>
                            <button 
                              onClick={() => {
                                const downloads = {
                                  'Parking Services Evaluation Checklist': '/downloads/vendor-evaluation-checklist.pdf',
                                  'Budget Planning Worksheet': '/downloads/budget-planning-worksheet.csv',
                                  'Implementation Timeline Template': '/downloads/implementation-timeline.pdf',
                                  'Performance Metrics Dashboard': '/downloads/performance-metrics.pdf'
                                }
                                const link = document.createElement('a')
                                link.href = downloads[doc.title] || '/downloads/vendor-evaluation-checklist.pdf'
                                link.download = doc.title.toLowerCase().replace(/\s+/g, '-') + (doc.type === 'Excel' ? '.csv' : '.pdf')
                                document.body.appendChild(link)
                                link.click()
                                document.body.removeChild(link)
                              }}
                              className="text-blue-600 text-sm font-medium hover:text-blue-700"
                            >
                              Download
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>

                  {/* Contact CTA */}
                  <div className="text-center p-8 bg-blue-50 rounded-lg">
                    <h3 className="text-2xl font-bold text-gray-900 mb-4">{rfpData.rfp.contact.title}</h3>
                    <p className="text-gray-600 mb-6">{rfpData.rfp.contact.description}</p>
                    <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
                      {rfpData.rfp.contact.services.map((service, index) => (
                        <div key={index} className="flex items-center gap-3">
                          <CheckCircle className="h-5 w-5 text-green-500 flex-shrink-0" />
                          <span className="text-gray-700">{service}</span>
                        </div>
                      ))}
                    </div>
                    <div className="text-center">
                      <h4 className="text-xl font-semibold text-gray-900 mb-2">{rfpData.rfp.contact.cta.title}</h4>
                      <p className="text-gray-600 mb-4">{rfpData.rfp.contact.cta.subtitle}</p>
                      <button 
                        onClick={() => window.open(rfpData.rfp.contact.cta.booking_link, '_blank')}
                        className="bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition-colors text-lg font-medium"
                      >
                        {rfpData.rfp.contact.cta.button_text}
                      </button>
                    </div>
                  </div>
                </div>
              ) : (
                /* Individual Industry RFP Template View */
                <div className="p-6">
                  <div className="flex items-center gap-4 mb-6">
                    <button 
                      onClick={() => setSelectedRFPIndustry(null)}
                      className="text-gray-500 hover:text-gray-700 p-2"
                    >
