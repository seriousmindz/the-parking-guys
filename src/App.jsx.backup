import { useState, useEffect } from 'react'
import { Button } from '@/components/ui/button.jsx'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card.jsx'
import { Badge } from '@/components/ui/badge.jsx'
import { 
  Car, 
  Phone, 
  Mail, 
  MapPin, 
  Shield, 
  Clock, 
  Users, 
  TrendingUp,
  Building,
  Plane,
  Hospital,
  GraduationCap,
  Trophy,
  ChevronRight,
  Star,
  CheckCircle
} from 'lucide-react'
import './App.css'
import parkingData from './assets/parking-data.json'
import solutionsData from './assets/solutions-data.json'
import technologyData from './assets/technology-data.json'
import caseStudiesData from './assets/case-studies.json'
import rfpData from './assets/rfp-data.json'
import blogData from './assets/blog-data-simple.json'
const nashvilleLogo = '/images/valet-nashville-logo.png'
const atlantaLogo = '/images/valet-atl-logo.png'
const oklahomaLogo = '/images/valet-okc-logo.png'
const alabamaLogo = '/images/valet-alabama-logo.png'
const parkingCompanyLogo = '/images/parking-company-logo.webp'

function App() {
  const [activeCity, setActiveCity] = useState('nashville')
  const [isVisible, setIsVisible] = useState(false)
  const [showCaseStudies, setShowCaseStudies] = useState(false)
  const [selectedCaseStudy, setSelectedCaseStudy] = useState(null)
  const [showTechnology, setShowTechnology] = useState(false)
  const [activeTechSection, setActiveTechSection] = useState('overview')
  const [showSolutions, setShowSolutions] = useState(false)
  const [selectedIndustry, setSelectedIndustry] = useState(null)
  const [showBlog, setShowBlog] = useState(false)
  const [selectedBlogPost, setSelectedBlogPost] = useState(null)
  const [showAbout, setShowAbout] = useState(false)
  const [showRFP, setShowRFP] = useState(false)
  const [selectedRFPIndustry, setSelectedRFPIndustry] = useState(null)
  const [comments, setComments] = useState({})
  const [newComment, setNewComment] = useState('')
  const [commentAuthor, setCommentAuthor] = useState('')

  useEffect(() => {
    setIsVisible(true)
    console.log('Blog data loaded:', blogData)
    // Initialize comments with some sample data
    setComments({
      'ai-revolution': [
        {
          id: 1,
          author: 'David Chen',
          company: 'Smart City Solutions',
          comment: 'Excellent insights on AI in parking! We\'ve seen similar results with our predictive analytics implementation.',
          date: '2 days ago',
          replies: []
        },
        {
          id: 2,
          author: 'Sarah Williams',
          company: 'Metro Parking Authority',
          comment: 'The 95% accuracy rate is impressive. How does the system handle unexpected events like weather changes?',
          date: '1 day ago',
          replies: [
            {
              id: 3,
              author: 'Dr. Sarah Chen',
              company: 'Smart Parking Institute',
              comment: 'Great question! Our AI models incorporate real-time weather data and historical patterns to adjust predictions dynamically.',
              date: '12 hours ago'
            }
          ]
        }
      ],
      'mobile-payments': [
        {
          id: 4,
          author: 'Mike Johnson',
          company: 'TechPark Solutions',
          comment: 'Mobile-first is definitely the way forward. Our customers love the convenience of contactless payments.',
          date: '3 days ago',
          replies: []
        }
      ]
    })
  }, [])

  const addComment = (postId) => {
    if (newComment.trim() && commentAuthor.trim()) {
      const comment = {
        id: Date.now(),
        author: commentAuthor,
        company: '',
        comment: newComment,
        date: 'Just now',
        replies: []
      }
      
      setComments(prev => ({
        ...prev,
        [postId]: [...(prev[postId] || []), comment]
      }))
      
      setNewComment('')
      setCommentAuthor('')
    }
  }

  const cities = {
    nashville: {
      ...parkingData.site.cities.nashville,
      logo: nashvilleLogo
    },
    atlanta: {
      ...parkingData.site.cities.atlanta,
      logo: atlantaLogo
    },
    oklahoma: {
      ...parkingData.site.cities.oklahoma,
      logo: oklahomaLogo
    },
    alabama: {
      ...parkingData.site.cities.alabama,
      logo: alabamaLogo
    }
  }

  const getServiceIcon = (service) => {
    const iconMap = {
      'Hotel Valet': Building,
      'Event Parking': Trophy,
      'Corporate Services': Users,
      'Restaurant Valet': Car,
      'Airport Parking': Plane,
      'Downtown Valet': Building,
      'Stadium Events': Trophy,
      'Medical Center Parking': Hospital
    }
    return iconMap[service] || Car
  }

  const getSolutionIcon = (title) => {
    const iconMap = {
      'Hospitality': Building,
      'Healthcare': Hospital,
      'Municipal & University': GraduationCap,
      'Airports & Transportation': Plane,
      'Stadiums & Venues': Trophy
