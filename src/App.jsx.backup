                    </button>
                    <div className="text-3xl">{selectedRFPIndustry.icon}</div>
                    <h3 className="text-2xl font-bold text-gray-900">{selectedRFPIndustry.name} RFP Template</h3>
                  </div>

                  <div className="grid lg:grid-cols-2 gap-8">
                    {/* RFP Template Details */}
                    <div>
                      <div className="bg-white border border-gray-200 rounded-lg p-6 mb-6">
                        <h4 className="text-xl font-semibold text-gray-900 mb-4">{selectedRFPIndustry.rfp_template.title}</h4>
                        
                        <div className="mb-6">
                          <h5 className="text-lg font-medium text-gray-900 mb-3">RFP Sections</h5>
                          <ul className="space-y-2">
                            {selectedRFPIndustry.rfp_template.sections.map((section, index) => (
                              <li key={index} className="flex items-center gap-3">
                                <CheckCircle className="h-4 w-4 text-green-500 flex-shrink-0" />
                                <span className="text-gray-700">{section}</span>
                              </li>
                            ))}
                          </ul>
                        </div>

                        <div className="mb-6">
                          <h5 className="text-lg font-medium text-gray-900 mb-3">Key Requirements</h5>
                          <ul className="space-y-2">
                            {selectedRFPIndustry.rfp_template.key_requirements.map((req, index) => (
                              <li key={index} className="flex items-center gap-3">
                                <div className="w-2 h-2 bg-blue-500 rounded-full flex-shrink-0"></div>
                                <span className="text-gray-700">{req}</span>
                              </li>
                            ))}
                          </ul>
                        </div>

                        <div>
                          <h5 className="text-lg font-medium text-gray-900 mb-3">Evaluation Criteria</h5>
                          <ul className="space-y-2">
                            {selectedRFPIndustry.rfp_template.evaluation_criteria.map((criteria, index) => (
                              <li key={index} className="flex items-center gap-3">
                                <div className="w-2 h-2 bg-purple-500 rounded-full flex-shrink-0"></div>
                                <span className="text-gray-700">{criteria}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </div>

                    {/* Budget Considerations */}
                    <div>
                      <div className="bg-blue-50 rounded-lg p-6 mb-6">
                        <h4 className="text-xl font-semibold text-gray-900 mb-4">Budget Considerations</h4>
                        
                        <div className="mb-4">
                          <h5 className="text-lg font-medium text-gray-900 mb-2">Typical Investment Range</h5>
                          <p className="text-2xl font-bold text-blue-600 mb-2">{selectedRFPIndustry.budget_considerations.typical_range}</p>
                          <p className="text-gray-600">Expected ROI: {selectedRFPIndustry.budget_considerations.roi_expectation}</p>
                        </div>

                        <div>
                          <h5 className="text-lg font-medium text-gray-900 mb-3">Cost Factors</h5>
                          <ul className="space-y-2">
                            {selectedRFPIndustry.budget_considerations.cost_factors.map((factor, index) => (
                              <li key={index} className="flex items-center gap-3">
                                <div className="w-2 h-2 bg-green-500 rounded-full flex-shrink-0"></div>
                                <span className="text-gray-700">{factor}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>

                      {/* Download CTA */}
                      <div className="bg-white border border-gray-200 rounded-lg p-6">
                        <h4 className="text-xl font-semibold text-gray-900 mb-4">Get Your Custom RFP Template</h4>
                        <p className="text-gray-600 mb-4">Download a fully customized RFP template for {selectedRFPIndustry.name.toLowerCase()} with industry-specific requirements and evaluation criteria.</p>
                        <div className="space-y-3">
                          <button 
                            onClick={() => window.open(rfpData.rfp.contact.cta.booking_link, '_blank')}
                            className="w-full bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-medium"
                          >
                            Schedule RFP Consultation
                          </button>
                          <button 
                            onClick={() => {
                              const link = document.createElement('a')
                              link.href = '/downloads/hospitality-rfp-template.pdf'
                              link.download = `${selectedRFPIndustry.name.toLowerCase().replace(/\s+/g, '-')}-rfp-template.pdf`
                              document.body.appendChild(link)
                              link.click()
                              document.body.removeChild(link)
                            }}
